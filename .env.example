# Имена и примеры. Реальные секреты только в .env, который не коммитится.

ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_CHAT_MODEL=openai/gpt-6.1-sol
ROUTERAI_STT_MODEL=openai/whisper-1

TG_BOT_TOKEN=
# Пусто: первый /start записывает владельца в data/flowci.db.
# Иначе список id через запятую, например 1001,1002.
TG_ALLOWED_USER_IDS=

VIKUNJA_URL=http://127.0.0.1:3456
VIKUNJA_TOKEN=
# Пусто: ищется проект с названием ровно FlowCI.
VIKUNJA_PROJECT_ID=

FLOWCI_INGEST_TOKEN=
FLOWCI_INGEST_HOST=127.0.0.1
FLOWCI_INGEST_PORT=8787
FLOWCI_TIMEZONE=Europe/Moscow
FLOWCI_MORNING_HOUR=9
FLOWCI_DATA_DIR=data
